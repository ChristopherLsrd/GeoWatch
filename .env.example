# Mot de passe de connexion à l'application
APP_PASSWORD=
# Secret de signature du cookie de session (au moins 32 caractères aléatoires)
SESSION_SECRET=
# Secret attendu par la route du cron (envoyé par Vercel en « Authorization: Bearer … »)
CRON_SECRET=
# Chaîne de connexion MongoDB Atlas (fournie par l'intégration Vercel)
MONGODB_URI=
# Nom de la base (facultatif, « geowatch » par défaut)
MONGODB_DB=
# Clé API TMDB (facultative) : langue originale des titres, pour la préférence « Version originale »
TMDB_API_KEY=

# Notifications push (générer avec « npx web-push generate-vapid-keys »)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com
